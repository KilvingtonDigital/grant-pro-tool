# GrantPro Environment Variables
# Copy this file to .env.local and fill in your values

# ─── Google APIs (same key as RoofQuote — enable these APIs in GCP console) ───
# Required APIs: Places API, Geocoding API, Maps Static API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# ─── Lead Notification (choose one or both) ────────────────────────────────────
# Option A: Webhook URL — GrantPro POSTs lead JSON here (Zapier, Make, CRM, etc.)
GRANT_LEAD_WEBHOOK_URL=""

# Option B: Resend email — sends formatted lead report via email
RESEND_API_KEY=""
GRANT_LEAD_TO_EMAIL="inspector@yourcompany.com"
GRANT_LEAD_FROM_EMAIL="grants@grantpro.app"
GRANT_LEAD_EMAIL_SUBJECT="New FORTIFIED Grant Lead"

# Option C: Google Sheets — add your Apps Script webhook URL here
GRANT_SHEETS_WEBHOOK_URL=""

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3010"
